    "/connector/v1/{connector_key}/{method}": {
      "post": {
        "tags": [
          "Connectors"
        ],
        "summary": "Execute connector action",
        "description": "Dispatches an operation to a registered destination connector with policy enforcement.\n\n**Supported Methods:**\n- `validate`: Validates content structure and destination constraints (length, non-empty text).\n- `publish`: Enforces destination policy, frequency cap, and idempotency before simulating publishing locally.\n- `get_status`: Looks up post details by ID (requires `post_id` in request body).\n- `delete`: Deletes a post by ID (requires `post_id` in request body).\n- `fetch_metrics`: Fetches normalized engagement metrics.\n- `refresh_auth`: Refreshes authorization token when supported.\n- `build_assist_pack`: Generates operator pack for assisted destinations.\n- `manifest`: Returns connector capability manifest.\n\n**Idempotency (`Idempotency-Key` header):**\n- For `publish`, pass the optional `Idempotency-Key: <unique_string>` header.\n- **First Request:** Processes publication normally and stores the response against `(connector_key, key)`.\n- **Duplicate Request:** When the same key is submitted again with the same request payload within the TTL window, the original response and original post ID are returned without creating another post or consuming frequency quota.\n- **Payload Conflict:** If the same key is reused with a different request payload, the server returns HTTP 409 Conflict with `error_code: IDEMPOTENCY_CONFLICT`.\n- **Scope & TTL:** Keys are strictly scoped per connector and expire automatically after `IDEMPOTENCY_TTL_SECONDS` (default 300s).\n- **Concurrency Safety:** Concurrent duplicate requests within the process are synchronized so only one post is created.\n\n*Important: Idempotency records are maintained entirely in-memory within this single application process; state resets when the process/container restarts and does not synchronize across multi-replica deployments.*",
        "operationId": "handle_connector_action_connector_v1__connector_key___method__post",
        "parameters": [
          {
            "name": "connector_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Connector Key"
            }
          },
          {
            "name": "method",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Method"
            }
          },
          {
            "name": "async",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Trigger asynchronous background execution for publish operations.",
              "title": "Async"
            },
            "description": "Trigger asynchronous background execution for publish operations."
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Standard RFC 7240 header; set to 'respond-async' for background processing.",
              "title": "Prefer"
            },
            "description": "Standard RFC 7240 header; set to 'respond-async' for background processing."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional idempotency key for 'publish' operations to prevent duplicate posts.",
              "examples": [
                "idem_123e4567-e89b-12d3-a456-426614174000"
              ],
              "title": "Idempotency-Key"
            },
            "description": "Optional idempotency key for 'publish' operations to prevent duplicate posts."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ConnectorRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Handle Connector Action Connector V1  Connector Key   Method  Post"
                }
              }
            }
          },
          "202": {
            "description": "Accepted - Publish operation accepted for background processing."
          },
          "400": {
            "description": "Bad Request - Invalid method, spec violation, missing content, or missing post ID."
          },
          "404": {
            "description": "Not Found - Unknown connector key or post ID not found."
          },
          "409": {
            "description": "Conflict - Idempotency key reused with a different request payload."
          },
          "429": {
            "description": "Too Many Requests - Frequency cap exceeded."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
